generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  supabaseUserId String?        @unique
  studentId      String         @unique
  password       String
  firstName      String
  middleName     String
  lastName       String
  suffix         String?
  yearLevel      Int
  degreeProgram  String
  personalEmail  String         @unique
  schoolEmail    String         @unique
  contactNumber  String
  facebookLink   String
  discordName    String?
  role           UserRole       @default(MEMBER)
  /// Backfill default APPROVED so the existing ~480 rows keep login. New
  /// applicants are inserted as PENDING by the app, explicitly.
  membershipStatus MembershipStatus @default(APPROVED)
  /// Legacy imports DEFAULT true (must claim via school-email link). New
  /// members from createPendingUser set this false (they chose a password).
  mustChangePassword Boolean @default(true)
  points         Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registration   Registration[]
  Transaction    Transaction[]
  sessions       Session[]
  accountTokens  AccountToken[]
  cartLines      MerchCartLine[]
  merchOrders    MerchOrder[]
  officerProfile OfficerProfile?
  restockRequests MerchRestockRequest[]
  committeeSeats CommitteeMember[]
  membershipApplicationsAsPayer MembershipApplication[] @relation("MembershipPayer")
  membershipDecisions           MembershipApplication[] @relation("MembershipDecider")
  membershipMemberships         MembershipApplicationMember[]
  joApplication                 JOApplication?
  joDecisions                   JOApplication[] @relation("JODecider")
  interviewSlotsCreated         InterviewSlot[] @relation("InterviewSlotCreator")
  interviewSlotsAsInterviewer   InterviewSlot[] @relation("InterviewSlotInterviewer")
}

/// One-time CLAIM / RESET links. Store SHA-256 of the raw token only.
model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  tokenHash String           @unique
  kind      AccountTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An opaque server-side session. `userId` is a real `User.id` — it used to
/// reference `studentId` while every other relation in this schema joined on
/// `id`, which forced call sites into `where: { userId: user.studentId }` and
/// read like a bug at every one of them.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sessions are looked up by user on every revoke and on every password
  /// change; without this each of those is a sequential scan.
  @@index([userId])
}

model Event {
  eventId       String         @id @default(cuid())
  name          String
  description   String?
  eventSemester EventSemester  @default(FIRST)
  venue         String
  dayOfWeek     String
  startDate     DateTime
  endDate       DateTime       @default(now())
  /// Amounts are authoritative. `feeNote` may add context, never a number
  /// that contradicts these (CLEANUP.md 4.4).
  priceOfficer    Float          @default(0)
  priceMember     Float          @default(0)
  priceNonMember  Float          @default(0)
  image         String?
  cardImage     String?
  gallery       String[]       @default([])
  isMultiDay      Boolean        @default(false)
  statusOverride  EventStatusOverride?
  // Extended details sourced from docs/event-details.md
  type                String[]     @default([])
  overview            String?
  mainObjective       String?
  specificObjectives  String[]     @default([])
  targetParticipants  String?
  /// Prose that supplements the price columns - what the fee covers, how to
  /// pay. Not a place to restate an amount.
  feeNote             String?
  parentId        String?
  parent          Event?         @relation("EventDays", fields: [parentId], references: [eventId])
  subEvents       Event[]        @relation("EventDays")
  registrations   Registration[]
}

/// A product in the chapter store. Items are never deleted when they run out —
/// SOLD_OUT keeps the record listed but un-reservable, HIDDEN pulls it off the
/// public store while keeping it in the console. DELETE is the only destructive
/// path and lives behind the admin editor.
model MerchItem {
  id          String        @id @default(cuid())
  /// URL key for /merchandise/[slug].
  slug        String        @unique
  name        String
  category    MerchCategory @default(APPAREL)
  /// Short line under the card / above the fold.
  blurb       String?
  description String?
  /// Peso price. Members-only pricing — there is no non-member tier.
  price       Float         @default(0)
  /// Gallery. The first entry doubles as the card cover.
  images      String[]      @default([])
  status      MerchStatus   @default(AVAILABLE)
  /// Flags the "NEW DROP" accent on the storefront card.
  isNewDrop   Boolean       @default(false)
  /// Manual ordering on the storefront (ascending).
  order       Int           @default(0)
  /// Shown in the item's facts list.
  pickupNote  String?
  paymentNote String?
  restockNote String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants   MerchVariant[]
  restockRequests MerchRestockRequest[]
}

/// A buyable variant of an item — a size, a colour, or the single implicit
/// "One size" row for things that don't vary.
model MerchVariant {
  id      String  @id @default(cuid())
  itemId  String
  /// "S", "M", "ONE SIZE", …
  label   String
  stock   Int     @default(0)
  /// Force this variant out of stock independently of the count.
  soldOut Boolean @default(false)
  order   Int     @default(0)

  item      MerchItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cartLines MerchCartLine[]
  orderLines MerchOrderLine[]

  @@unique([itemId, label])
}

/// A member's basket. Persisted server-side so the cart survives devices and
/// can be validated against live stock at checkout.
model MerchCartLine {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant MerchVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

/// A checked-out reservation. Nothing is paid online — checking out holds the
/// units for `expiresAt`, and the member settles with an officer on collection.
model MerchOrder {
  id        String           @id @default(cuid())
  /// Short human code the member quotes at the ACM room.
  reference String           @unique
  userId    String
  status    MerchOrderStatus @default(PENDING)
  /// Peso total, snapshotted at checkout.
  total     Float            @default(0)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  /// End of the hold window. Past this, the reservation may be released.
  expiresAt DateTime

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines MerchOrderLine[]
}

/// One line of a reservation. Name/label/price are snapshotted so a later edit
/// to the catalogue never rewrites what somebody reserved.
model MerchOrderLine {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String?
  itemName     String
  variantLabel String
  unitPrice    Float
  quantity     Int     @default(1)

  order   MerchOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant MerchVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

/// "Notify me when restocked" on a sold-out item.
model MerchRestockRequest {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item MerchItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

/// A chapter committee. Every committee — the six that exist today and any an
/// admin adds later — renders through the SAME page at /committee/[slug]. The
/// record supplies content; the design fixes section order and hierarchy, which
/// is what stops six committees from becoming six different websites.
model Committee {
  id     String @id @default(cuid())
  /// URL key for /committee/[slug].
  slug   String @unique
  name   String
  /// Line beside the number in the hero, e.g. "STANDING COMMITTEE · AY 2026–27".
  kicker String?
  /// Emblem key from the fixed set in types/committee.ts. Constrained on purpose:
  /// the diamond mark has to read at 230px, so admins pick, they don't upload.
  emblem String @default("pen")
  /// Hero paragraph.
  mandate String?
  /// The three-line card on the index. Falls back to `mandate` when empty.
  blurb   String?
  /// Manual ordering on the index (ascending). The N° in the hero follows it.
  order   Int @default(0)
  status  CommitteeStatus @default(PUBLISHED)

  /// Which set of roster positions this committee offers. STANDARD is head /
  /// co-head / member; DEV is the ACMx split — project lead, lead dev, junior
  /// devs. Stored on the record rather than hardcoded against the ACMx slug so
  /// renaming the committee doesn't silently change its roles.
  track   CommitteeTrack @default(STANDARD)

  /// The single three-way recruiting choice. Reconciled against `openSeats`
  /// server-side so the page can never advertise seats that don't exist.
  recruiting   CommitteeRecruiting @default(NOT_YET)
  openSeats    Int       @default(0)
  /// Copy inside the recruiting panel.
  callBody     String?
  callDeadline DateTime?
  applyUrl     String?
  contactEmail String?

  formedYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsibilities CommitteeResponsibility[]
  projects         CommitteeProject[]
  facts            CommitteeFact[]
  members          CommitteeMember[]
  questions        CommitteeQuestion[]
  joApplications   JOApplication[]
}

/// One row of "what this committee owns". Numbered automatically by `order`,
/// so a committee with two duties and one with nine both render correctly.
model CommitteeResponsibility {
  id          String  @id @default(cuid())
  committeeId String
  title       String
  description String?
  order       Int     @default(0)

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@index([committeeId])
}

/// A "current work" row. The whole block hides when a committee has none,
/// rather than showing an empty header.
model CommitteeProject {
  id          String                 @id @default(cuid())
  committeeId String
  title       String
  /// One-line context under the title.
  meta        String?
  status      CommitteeProjectStatus @default(IN_PROGRESS)
  order       Int                    @default(0)

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@index([committeeId])
}

/// A free key/value row in "At a glance". Free-form on purpose: a committee
/// with no co-head simply has no co-head row, instead of an empty fixed field.
model CommitteeFact {
  id          String @id @default(cuid())
  committeeId String
  label       String
  value       String
  order       Int    @default(0)

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@index([committeeId])
}

/// A roster entry. Rosters are built by picking real accounts, so `userId` is
/// how a seat grants console access; `name` is still stored alongside it so the
/// roster survives the account being deleted.
model CommitteeMember {
  id          String                @id @default(cuid())
  committeeId String
  userId      String?
  name        String
  /// The lane under the portrait — "LAYOUT", "MOTION", …
  roleLabel   String?
  position    CommitteeMemberRole   @default(MEMBER)
  /// Shown on the lead cards only.
  bio         String?
  photo       String?
  order       Int                   @default(0)

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// One seat per person per committee. Postgres treats NULLs as distinct, so
  /// legacy unlinked entries are unaffected.
  @@unique([committeeId, userId])
  @@index([committeeId])
  @@index([userId])
}

model Transaction {
  transaction_id String          @id @default(cuid())
  user_id        String
  fullName       String
  schoolEmail    String
  imageURL     String?
  
  type           TransactionType
  points         Int?
  description    String
  status         TransactionStatus @default(PENDING)
  created_at     DateTime        @default(now())
  User           User?            @relation(fields: [user_id], references: [id])
}

model Registration {
  id            String           @id @default(cuid())
  userId        String?
  eventId       String
  fullName      String
  studentNumber String
  schoolEmail   String
  contactNumber String
  facebookLink  String
  yearLevel     Int
  section       String
  professor     String
  degreeProgram String
  role          RegistrationRole
  createdAt     DateTime         @default(now())
  attendance    Attendance?
  event         Event            @relation(fields: [eventId], references: [eventId])
  user          User?            @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@unique([eventId, schoolEmail])
  @@unique([eventId, studentNumber])
}

model Attendance {
  id             String           @id @default(cuid())
  registrationId String           @unique
  userId         String?
  eventId        String
  fullName       String
  studentNumber  String
  schoolEmail    String
  yearLevel      Int
  degreeProgram  String
  section        String
  professor      String
  timeIn         DateTime
  timeOut        DateTime?
  role           RegistrationRole
  createdAt      DateTime         @default(now())
  registration   Registration     @relation(fields: [registrationId], references: [id])
}

/// Featured videos shown in the dashboard hero slideshow. Admins upload a
/// video (or paste a URL) together with a redirect link users are sent to.
model FeaturedVideo {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  /// Playable video source (uploaded file public URL, or a direct video URL).
  videoUrl    String
  /// Where the user is redirected when they click the slide / "Watch".
  redirectUrl String?
  /// Manual ordering in the slideshow (ascending).
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  MEMBER
  JUNIOR_OFFICER
  MEDIA_OFFICER
  FINANCE_JUNIOR_OFFICER
  SECRETARIAT_JUNIOR_OFFICER
  SECRETARIAT
  EXECUTIVES
  EXECUTIVES_MEDIA
  VP_EXTERNAL
  VP_INTERNAL
  PRESIDENT
  ADMIN
}

enum EventSemester {
  FIRST  @map("1st")
  SECOND @map("2nd")
  THIRD  @map("3rd")
}

/// An officer explicit call, overriding what the dates imply. Null means
/// derive it - see getEventStatus in src/types/events.ts.
enum EventStatusOverride {
  UPCOMING
  ONGOING
  FINISHED
}

enum RegistrationRole {
  MEMBER
  NON_MEMBER
}

enum TransactionType {
  ATTENDANCE
  REWARDS
  TASKS
  PURCHASE
}
enum MerchCategory {
  APPAREL
  ACCESSORIES
  STICKERS
  STATIONERY
}

/// The single three-way availability choice from the admin editor. SOLD_OUT
/// keeps the item listed and readable; HIDDEN removes it from the public store.
enum MerchStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

/// PUBLISHED shows the committee on the index and at its own URL. HIDDEN keeps
/// the record and its roster while taking it off the public site.
enum CommitteeStatus {
  PUBLISHED
  HIDDEN
}

/// Only RECRUITING gets the accent panel — on this page orchid means
/// "you can act on this", so FULL and NOT_YET stay neutral.
enum CommitteeRecruiting {
  RECRUITING
  FULL
  NOT_YET
}

enum CommitteeProjectStatus {
  IN_PROGRESS
  REVIEW
  SHIPPED
}

/// Roster positions across both tracks. The first four are single-seat and
/// carry edit access to their own committee; MEMBER and JUNIOR_DEV are the
/// unlimited, view-only ranks.
enum CommitteeMemberRole {
  HEAD
  CO_HEAD
  MEMBER
  PROJECT_LEAD
  LEAD_DEV
  JUNIOR_DEV
}

/// STANDARD: head, co-head, members. DEV: project lead, lead dev, junior devs —
/// the ACMx split.
enum CommitteeTrack {
  STANDARD
  DEV
}

enum MerchOrderStatus {
  PENDING
  READY
  COLLECTED
  CANCELLED
}

enum TransactionStatus{
  PENDING
  ACCEPTED
  REJECTED
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountTokenKind {
  CLAIM
  RESET
}

enum BundleKind {
  SOLO
  PARTNER
  BUNDLE_5
  BUNDLE_8
}

enum ApplicationKind {
  NEW
  RENEWAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JOApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  WAITLISTED
  REJECTED
}

/// One Membership Drive application. The payer holds the proof; N member rows
/// cover the bundle. Approve/reject is per-application; B1 forbids flipping an
/// already-APPROVED User to REJECTED.
model MembershipApplication {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  payerUserId     String
  bundle          BundleKind
  kind            ApplicationKind
  proofStorageKey String
  proofUploadedAt DateTime
  status          ApplicationStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  rejectionReason String?

  payer     User                         @relation("MembershipPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  decidedBy User?                        @relation("MembershipDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  members   MembershipApplicationMember[]

  @@index([status])
  @@index([payerUserId])
}

/// One person on a membership application.
/// `createdAsPending` is true only when THIS application inserted the User as
/// PENDING. B1: reject/approve may only flip membershipStatus when this is true
/// AND the User is still PENDING.
model MembershipApplicationMember {
  id               String @id @default(cuid())
  applicationId    String
  userId           String
  orderIndex       Int    @default(0)
  createdAsPending Boolean

  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([applicationId, userId])
  @@index([userId])
}

/// Exactly three Likert statements per committee, admin-editable. Not hardcoded.
model CommitteeQuestion {
  id          String  @id @default(cuid())
  committeeId String
  order       Int
  text        String
  active      Boolean @default(true)

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  answers   JOAnswer[]

  @@unique([committeeId, order])
}

/// One JO / committee-fit application per User. shareToken is the public card key.
model JOApplication {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            String             @unique
  targetCommitteeId String
  shareToken        String             @unique
  status            JOApplicationStatus @default(PENDING)
  decidedByUserId   String?
  decidedAt         DateTime?

  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  targetCommittee Committee      @relation(fields: [targetCommitteeId], references: [id], onDelete: Restrict)
  decidedBy       User?          @relation("JODecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  answers         JOAnswer[]
  booking         InterviewBooking?

  @@index([status])
}

model JOAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionId    String
  value         Int

  application JOApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    CommitteeQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, questionId])
}

model InterviewSlot {
  id                String   @id @default(cuid())
  startsAt          DateTime
  durationMinutes   Int      @default(30)
  interviewerUserId String?
  location          String
  capacity          Int      @default(1)
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  interviewer User?              @relation("InterviewSlotInterviewer", fields: [interviewerUserId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("InterviewSlotCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bookings    InterviewBooking[]

  @@index([startsAt])
}

/// One booking per JO application. Slot capacity is enforced in the book
/// transaction with SELECT … FOR UPDATE, not by this unique alone.
model InterviewBooking {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  slotId        String
  applicationId String   @unique

  slot        InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  application JOApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([slotId, applicationId])
  @@index([slotId])
}
/// The presentation half of an officer on the public Officers page.
///
/// Deliberately *only* what the account cannot already say. Who holds a post is
/// `User.role`, edited in People & Roles — so a turnover updates the public page
/// with no deploy, which was the whole complaint in CLEANUP.md 7.4. The name,
/// course and school email all come from the account too; duplicating them here
/// would create a second truth that drifts.
///
/// A missing row is not an error: an officer with no profile still appears, with
/// the placeholder portrait and no tagline.
model OfficerProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// One signature line — their focus for the term.
  tagline String?
  /// Official portrait. Null renders the labelled placeholder.
  photo   String?
  /// When they took the post, e.g. "Aug 2026". Free text: terms are described,
  /// not computed, and nobody needs to query on it.
  since   String?

  instagram String?
  linkedin  String?

  /// Manual ordering *within* a role. Across roles the order comes from
  /// USER_ROLES, which is already ranked highest to lowest.
  order Int @default(0)

  /// Lets an officer be held back from the public page without touching their
  /// account role, which would take their console access with it.
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
