# Environment variables for acmx2025.
#
# Copy to `.env` for local work and fill in real values. `.env` is gitignored
# and must stay that way — it holds the database password and the Supabase
# service-role key, which bypasses row-level security.
#
# For deployments, these are NOT read from the repo. Set them on the hosting
# project, scoped to Production, Preview and Development as needed. If more than
# one deployment project exists, each carries its own copy — variables set on
# one do not apply to another.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time and is readable by anyone. Never put a secret behind that prefix.

# ── Required ────────────────────────────────────────────────────

# Postgres connection string. Read by prisma/schema.prisma at runtime.
# Secret.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase project URL. Read by src/app/api/upload/route.ts. Public.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase service-role key. Read by src/app/api/upload/route.ts on the server
# only. Bypasses row-level security — treat it like a root password, and keep
# the NEXT_PUBLIC_ prefix off it.
NEXT_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Absolute site origin for claim/reset email links (no trailing slash).
# Must be the production URL in production — never localhost there.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Account claim / reset email (SPEC-D5) ───────────────────────
#
# Gmail App Password for acmx.feu.it@gmail.com (2-Step Verification ON).
# Never commit real values.
GMAIL_USER="acmx.feu.it@gmail.com"
GMAIL_APP_PASSWORD=""

# ── Campaign windows (Fathi-set only — not an admin screen) ─────
#
# Inclusive calendar dates (Asia/Manila). Outside these, public membership
# apply and JO apply show a neutral closed/opens state.
MEMBERSHIP_WINDOW_START="2026-08-31"
MEMBERSHIP_WINDOW_END="2026-09-05"
JO_WINDOW_START="2026-09-01"
JO_WINDOW_END="2026-09-23"

# ── Set automatically ───────────────────────────────────────────
#
# Booth live wall / celebration. Server-only Event.eventId of the drive booth.
# Not NEXT_PUBLIC — the stream route reads this so callers cannot enumerate events.
BOOTH_EVENT_ID=""

# ── No longer used ──────────────────────────────────────────────
#
# These may still exist in older .env files and in the Vercel dashboard. No
# code on this branch reads them; they are safe to remove.
#
#   QR_SECRET_KEY        only consumer was src/services/scanner/scannerService.ts,
#                        removed along with the QR scanner subsystem in 0ac871d.
#                        Restore this if the scanner is ever brought back.
#   SUPABASE_JWKS_URL    unreferenced.
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#                        its only consumer was src/lib/supabase.ts, an anon
#                        client nothing imported; deleted during the cleanup.
#                        Every Supabase call now goes through the upload route's
#                        server-side service-role client. Restore this the
#                        moment anything needs to talk to Supabase from the
#                        browser.
#
# To confirm this list is still accurate:
#   grep -rhoE "process\.env\.[A-Z_0-9]+" src prisma scripts | sort -u
# (DATABASE_URL will not appear — Prisma reads it from schema.prisma, not code.)
