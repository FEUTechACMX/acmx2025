# Environment variables for acmx2025.
#
# Copy to `.env` for local work and fill in real values. `.env` is gitignored
# and must stay that way — it holds the database password and the Supabase
# service-role key, which bypasses row-level security.
#
# For deployments, these are NOT read from the repo. Set them per project in
# Vercel → Settings → Environment Variables, scoped to Production, Preview and
# Development as needed. Note this repo builds TWO Vercel projects
# (acmx2025 and acmx2025-zxi7); variables set on one do not apply to the other.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time and is readable by anyone. Never put a secret behind that prefix.

# ── Required ────────────────────────────────────────────────────

# Postgres connection string. Read by prisma/schema.prisma at runtime.
# Secret.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase project URL. Read by src/lib/supabase.ts and the upload route.
# Public.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon key — the browser-side key, constrained by row-level security.
# Read by src/lib/supabase.ts. Public.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service-role key. Read by src/app/api/upload/route.ts on the server
# only. Bypasses row-level security — treat it like a root password, and keep
# the NEXT_PUBLIC_ prefix off it.
NEXT_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Set automatically ───────────────────────────────────────────
#
# NODE_ENV is provided by Next.js and Vercel. Do not set it by hand.

# ── No longer used ──────────────────────────────────────────────
#
# These may still exist in older .env files and in the Vercel dashboard. No
# code on this branch reads them; they are safe to remove.
#
#   QR_SECRET_KEY        only consumer was src/services/scanner/scannerService.ts,
#                        removed along with the QR scanner subsystem in 0ac871d.
#                        Restore this if the scanner is ever brought back.
#   NEXT_PUBLIC_BASE_URL unreferenced.
#   SUPABASE_JWKS_URL    unreferenced.
