# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Generated from DOCUMENTATION.md on demand — not a source artefact.
DOCUMENTATION.pdf

# Internal working / oversight assets — LOCAL ONLY, never pushed.
# The only doc that ships is CHANGES.md (root) — the developer-facing summary.
# (/sql ships: it's the schema contract the code depends on, not a private note.)
/docs/
/.claude/
CLAUDE.md
IMPLEMENTATION_PLAN.md
report.md
FLOWS.md
flows.html
scripts/build-flows-doc.mjs
scripts/build-president-doc.mjs

# Generated Word docs — rebuild from scripts/ (build-flows-doc.mjs, build-president-doc.mjs)
flows.docx
PRESIDENT-role-access-review.docx
.flows-doc-tmp/

# Database backups / dumps — NEVER commit (contains member PII)
*.dump
*.sql.dump
*.backup
